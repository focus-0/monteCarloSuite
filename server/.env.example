# Copy to server/.env and adjust as needed (loaded automatically via dotenv in server.js)
# All defaults are defined in server/config.js — this file documents recommended values.
# For Docker Compose, keep LLM_PROVIDER / GROQ_API_KEY / GEMINI_API_KEY / OLLAMA_URL aligned with root .env.

# --- Server ---
PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/montecarlo
MONGO_DB_NAME=montecarlo
CLIENT_BUILD_PATH=
BODY_LIMIT=10kb

# --- CORS (comma-separated origins, production only) ---
CORS_ORIGINS=http://localhost:3000,https://montecarlosuitefe.onrender.com

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_PRODUCTION=1000
RATE_LIMIT_MAX_DEVELOPMENT=10000

# --- LLM provider (local dev) ---
# Default: ollama + gemma4:12b. Docker/Render use Gemini — see root .env.example (README §9.3).
LLM_PROVIDER=ollama

# --- Local Ollama (LLM_PROVIDER=ollama) — not available on Render ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
# 0 = no timeout (Node fetch defaults to 300s — too short for 12B local inference)
OLLAMA_TIMEOUT_MS=0
# GEMMA_MODEL=gemma4:12b

# --- Groq cloud (LLM_PROVIDER=groq) — optional alternative ---
# Free key: https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_KEYS_URL=https://console.groq.com/keys

# --- Google Gemini (LLM_PROVIDER=gemini or google) — Docker/Render default ---
# Key: https://aistudio.google.com/apikey
# Store real key in server/.env only (never commit). Root .env sets LLM_PROVIDER=gemini for deploy.
# GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_KEYS_URL=https://aistudio.google.com/apikey

# --- Market data ---
DEFAULT_SYMBOL=AAPL
MARKET_NEWS_RSS_URL=https://news.google.com/rss/search
MARKET_NEWS_RSS_LOCALE=en-US
MARKET_NEWS_RSS_REGION=US
MARKET_NEWS_DEFAULT_COUNT=5
MARKET_NEWS_MAX_COUNT=20

# --- Polygon (optional intraday data source) ---
# POLYGON_API_KEY=
POLYGON_API_BASE_URL=https://api.polygon.io
POLYGON_INTRADAY_LIMIT=500

# --- Intraday / MFT arena defaults ---
INTRADAY_MAX_BARS=390
INTRADAY_ROLLING_VOL_WINDOW=20
INTRADAY_DEFAULT_VOL=0.25
MFT_DEFAULT_DATA_SOURCE=yahoo
MFT_DEFAULT_CAPITAL=100000
MFT_DEFAULT_TIME_WINDOW=30
MFT_DEFAULT_TICK_INTERVAL_MS=2000
MFT_DEFAULT_GEMMA_INTERVAL=5

# --- Agent tool defaults ---
AGENT_GREEKS_NUM_TRIALS=100000
AGENT_NEWS_DEFAULT_COUNT=5

# --- Recommendation vs Greeks consistency checks ---
VALIDATION_STRONG_DELTA=0.5
VALIDATION_STRONG_VEGA=25
